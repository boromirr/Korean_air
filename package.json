    "test": "vitest run",
    "build": "tsc && node cloud/build-site.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
